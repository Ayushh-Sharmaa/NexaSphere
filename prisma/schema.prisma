datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

model User {
  id               String              @id @default(uuid())
  email            String              @unique
  name             String?
  password         String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspaceMembers WorkspaceMember[]
  posts            Post[]
  logs             Log[]
  feedbacks        EventFeedback[]
  actionItems      ActionItem[]
  settingsChanges  SettingsChangeLog[]
  certificates     Certificate[]
  registrations    EventRegistration[]

  @@index([createdAt])
}

model Workspace {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          WorkspaceMember[]
  roles            Role[]
  posts            Post[]
  logs             Log[]
  webhookEndpoints WebhookEndpoint[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  roleId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  workspaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions Permission[]      @relation("RolePermissions")
  members     WorkspaceMember[]

  @@unique([name, workspaceId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles Role[] @relation("RolePermissions")
}

model Post {
  id          String   @id @default(uuid())
  title       String
  content     String?
  published   Boolean  @default(false)
  authorId    String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Certificate {
  id                 String    @id @default(uuid())
  code               String    @unique
  userId             String
  eventId            String
  attendeeName       String?
  eventName          String?
  date               DateTime  @default(now())
  completionCriteria String?
  status             String    @default("PENDING") // PENDING, ISSUED, VERIFIED, REJECTED
  verified           Boolean   @default(false)
  verifiedAt         DateTime?
  expiresAt          DateTime?
  pdfUrl             String?
  qrUrl              String?
  revoked            Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id])
}

model Log {
  id          String    @id @default(uuid())
  action      String
  details     String?
  userId      String?
  workspaceId String
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  REVOKE
}

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String
  action    AuditAction
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?

  timestamp DateTime    @default(now())
}

model VenueLayout {
  id        String   @id @default(uuid())
  name      String
  gridData  Json     // Holds dimensions (rows/cols) and cell matrix (types: SEAT, VIP, AISLE, BLOCKED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
}

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String?
  venueLayoutId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  venueLayout   VenueLayout?        @relation(fields: [venueLayoutId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  seatCode  String?  // e.g., "A-12" or "VIP-B4"
  status    String   @default("CONFIRMED") // e.g., CONFIRMED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, seatCode]) // Ensures no duplicate seats per event in DB
  @@index([eventId])
  @@index([userId])
}

model EventFeedback {
  id               String   @id @default(uuid())
  eventId          String
  userId           String?
  ratingOverall    Int
  wouldAttendAgain Boolean?
  recommendFriend  Boolean?
  ratingVenue      Int?
  ratingContent    Int?
  ratingSpeaker    Int?
  ratingPace       Int?
  suggestions      String?
  bestParts        String?
  sentiment        String?  @default("neutral")
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ActionItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("pending")
  assigneeId  String?
  eventId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  environment String   @default("development")
  key         String
  value       String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([environment, key], name: "environment_key")
  @@index([environment])
}

model SettingsChangeLog {
  id            String   @id @default(cuid())
  environment   String
  key           String
  previousValue String?  @db.Text
  newValue      String   @db.Text
  isRollback    Boolean  @default(false)
  changedById   String?
  changedBy     User?    @relation(fields: [changedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([environment, key])
  @@index([changedById])
}

model WebhookEndpoint {
  id          String            @id @default(uuid())
  workspaceId String
  url         String
  secret      String
  active      Boolean           @default(true)
  events      String[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id           String          @id @default(uuid())
  endpointId   String
  payload      Json
  responseCode Int?
  success      Boolean
  attempts     Int             @default(1)
  createdAt    DateTime        @default(now())

  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model EventPricing {
  id              String   @id @default(uuid())
  eventId         String   @unique
  basePrice       Float    // Original / standard price in INR
  currentPrice    Float    // Live computed price
  minPrice        Float    // Floor - never go below this
  maxPrice        Float    // Cap - never exceed this
  capacity        Int      // Total seats
  registrations   Int      @default(0)
  eventDate       DateTime // Used for time-based tier calculation
  adminOverride   Float?   // Admin can pin a manual price (null = use algorithm)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  priceHistory    PriceHistory[]
}

model PriceHistory {
  id        String       @id @default(uuid())
  pricingId String
  price     Float
  reason    String       // e.g. "early_bird", "demand_80pct", "admin_override"
  createdAt DateTime     @default(now())

  pricing   EventPricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)
}

model ArchivedReport {
  id          String   @id @default(cuid())
  environment String   @default("development")
  key         String
  value       String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([environment, key], name: "environment_key")
  @@index([environment])
}
