# ── NexaSphere Full-Stack Production Environment Configuration ───────────────
# Copy this file to .env / .env.local — NEVER commit actual secret credentials.

# ── Architecture Overview ─────────────────────────────────────────────────────
# Frontend (website & admin-dashboard) -> Clerk Identity -> Express API (server/api/v1) -> Supabase PostgreSQL

# ── Server Configuration (server/.env) ────────────────────────────────────────
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5001

# ── Database Layer (Supabase PostgreSQL via SSL) ──────────────────────────────
# PostgreSQL Connection URL for Express backend service
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API credentials (used for storage buckets, edge queries, and service operations)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Authentication (Clerk) ───────────────────────────────────────────────────
# Backend credentials for token verification via @clerk/backend authenticateRequest()
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5001

# ── Website Frontend (website/.env) ──────────────────────────────────────────
# Used by React 19 / Vite client application
VITE_API_BASE=http://localhost:8787
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Admin Dashboard Frontend (admin-dashboard/.env) ───────────────────────────
# Used by Vite admin control center
VITE_API_BASE=http://localhost:8787
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
